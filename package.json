{
  "name": "cubo-cfop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify": "tsx scripts/verify.mts",
    "verify:wca": "tsx scripts/check-wca-oll.mts",
    "verify:verbose": "tsx scripts/verify.mts --verbose",
    "test": "npm run typecheck && npm run verify && npm run verify:wca && npm run verify:images && npm run verify:refs && npm run verify:cube && npm run verify:diagrams",
    "docs": "tsx scripts/docs-casos.mts",
    "verify:refs": "tsx scripts/check-refs.mts",
    "verify:cube": "tsx scripts/check-cube-algebra.mts",
    "verify:diagrams": "tsx scripts/check-diagrams.mts",
    "svg": "tsx scripts/gen-case-svg.mts",
    "verify:images": "tsx scripts/check-diagrams.mts"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@react-three/drei": "^9.117.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-parse": "^1.1.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
